build/
.qtc_clangd/
.qtcreator/

.zig-cache/
zig-out/
# A cross build is installed next to the host one with `zig build -p zig-out-<triple>`,
# so host and target archives do not overwrite each other. See qnnt2.pri in vega-os.
zig-out-*/
*.o

# Generated by `zig build wheel`: the shared library is copied into the package so
# setuptools can pick it up as package data.
python/qnnt/_lib/*.dylib
python/qnnt/_lib/*.so
python/qnnt/_lib/*.dll
python/**/__pycache__/
python/*.egg-info/

# The DIRIGERA bearer token. It grants control of a house's lights and sits in the working
# directory by default, so it is ignored here rather than left one `git add .` away from
# being published. dirigera-bridge writes it 0600 for the same reason.
dirigera_token
